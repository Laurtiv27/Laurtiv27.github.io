---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a class="project-item" href={project.url} target="_blank" rel="noopener noreferrer">
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  <div class="project-meta">
    {project.stack.map((s) => <span class="tag">{s}</span>)}
  </div>
</a>
