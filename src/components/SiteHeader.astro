---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/projects', label: '作品' },
  { href: '/blog', label: '博客' },
  { href: '/about', label: '关于' },
  { href: 'https://github.com/Laurtiv27', label: 'GitHub', external: true },
];
---

<header class="site-header">
  <div class="wrap-narrow inner">
    <a class="brand" href="/">Lautriv</a>
    <nav class="nav" aria-label="主导航">
      {
        links.map((link) =>
          link.external ? (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          ) : (
            <a
              href={link.href}
              aria-current={path === link.href || path.startsWith(link.href + '/') ? 'page' : undefined}
            >
              {link.label}
            </a>
          ),
        )
      }
    </nav>
  </div>
</header>
